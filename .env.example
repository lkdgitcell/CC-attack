# HTTP Load Tester EDU - Configuration

# Application Settings
APP_NAME="HTTP Load Tester EDU"
DEBUG=false

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json or console
LOG_FILE=logs/app.log

# Web Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_RELOAD=false

# Security
ENABLE_WHITELIST=true
SIMULATION_MODE_DEFAULT=true
REQUIRE_AUTH_TOKEN=false
AUTH_TOKEN=  # Set a secure token for production

# Performance
MAX_CONCURRENT_REQUESTS=1000
CONNECTION_POOL_SIZE=100
REQUEST_TIMEOUT=30

# Proxy Settings
PROXY_CHECK_TIMEOUT=5
PROXY_CHECK_URL=http://1.1.1.1

# Paths
DATA_DIR=data
LOGS_DIR=logs
PROXY_DIR=proxies
